# Copy this file to .env for local development. Never commit .env.
PAPER_TOOLS_HOST=127.0.0.1
PAPER_TOOLS_PORT=8000
PAPER_TOOLS_DEBUG=false
# PAPER_TOOLS_DATA_DIR=C:/path/to/paper-tools-data
# PAPER_TOOLS_DATABASE_URL=sqlite+pysqlite:///C:/path/to/paper-tools-data/paper_tools.sqlite3
PAPER_TOOLS_TYPST_EXECUTABLE=typst
PAPER_TOOLS_COMPILE_TIMEOUT_SECONDS=60
PAPER_TOOLS_UPLOAD_MAX_BYTES=20971520
PAPER_TOOLS_ALLOWED_UPLOAD_EXTENSIONS=.png,.jpg,.jpeg,.svg,.pdf,.csv,.json,.txt,.yaml,.yml
PAPER_TOOLS_BACKUP_COUNT=10
PAPER_TOOLS_AUTOSAVE_DELAY_SECONDS=1.5
PAPER_TOOLS_GENERATION_PROVIDER=rule-based
PAPER_TOOLS_GENERATION_TIMEOUT_SECONDS=120
PAPER_TOOLS_GENERATION_TEMPERATURE=0.2
PAPER_TOOLS_MAXIMUM_OUTPUT_TOKENS=4096
PAPER_TOOLS_OLLAMA_URL=http://127.0.0.1:11434
PAPER_TOOLS_OLLAMA_MODEL=llama3.2
# PAPER_TOOLS_OPENAI_COMPATIBLE_BASE_URL=https://provider.example/v1
# PAPER_TOOLS_OPENAI_API_KEY=replace-me
# PAPER_TOOLS_OPENAI_COMPATIBLE_MODEL=replace-me
PAPER_TOOLS_JAPANESE_PUNCTUATION=，．
PAPER_TOOLS_ENGLISH_VARIANT=american
