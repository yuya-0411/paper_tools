#set page(paper: "a4", margin: (x: 18mm, y: 18mm))
#set text(size: 10pt, lang: "{{ language }}"{% if english_region %}, region: "{{ english_region }}"{% endif %})
#set par(justify: true, leading: 0.62em)
#set heading(numbering: "1.")
{% if citation_keys %}// paper-tools-citations:{% for citation_key in citation_keys %} @{{ citation_key }}{% endfor %}
{% endif %}

#align(center)[
  #text(16pt, weight: "bold")[{{ title }}]
  #v(5pt)
  {% if authors %}{% for author in authors %}{{ author.name }}{% if not loop.last %}{{ author_separator }}{% endif %}{% endfor %}{% else %}{{ author_placeholder }}{% endif %}
]

#block(stroke: 0.4pt + luma(190), inset: 7pt)[
  *{{ abstract_label }}* — {% if has_abstract %}#include "sections/abstract.typ"{% else %}{{ abstract }}{% endif %}

  *{{ keywords_label }}:* {% for keyword in keywords %}{{ keyword }}{% if not loop.last %}{{ keyword_separator }}{% endif %}{% endfor %}
]

{% for section in sections %}#include "sections/{{ section.id }}.typ"
{% endfor %}
