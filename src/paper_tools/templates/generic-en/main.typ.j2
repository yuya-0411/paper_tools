#set page(paper: "a4", margin: (x: 24mm, y: 23mm))
#set text(size: 10.5pt, lang: "en", region: "{{ english_region }}")
#set par(justify: true, leading: 0.72em)
#set heading(numbering: "1.")
{% if citation_keys %}// paper-tools-citations:{% for citation_key in citation_keys %} @{{ citation_key }}{% endfor %}
{% endif %}

#align(center)[
  #text(17pt, weight: "bold")[{{ title }}]
  #v(8pt)
  {% if authors %}{% for author in authors %}{{ author.name }}{% if author.affiliation %}, {{ author.affiliation }}{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}{% else %}{{ author_placeholder }}{% endif %}
]

#block(fill: luma(246), inset: 10pt)[
  *Abstract*\
  {% if has_abstract %}#include "sections/abstract.typ"{% else %}{{ abstract }}{% endif %}

  *Keywords—* {% for keyword in keywords %}{{ keyword }}{% if not loop.last %}, {% endif %}{% endfor %}
]

{% for section in sections %}#include "sections/{{ section.id }}.typ"
{% endfor %}
